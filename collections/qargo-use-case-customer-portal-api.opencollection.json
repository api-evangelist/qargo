{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qargo TMS API / Accounting Use case / Customer portal API",
    "version": "1.2.0"
  },
  "items": [
    {
      "info": {
        "name": "Use case / Customer portal",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download Document",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qargo.com/v1/documents/document/:id/download",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "direct",
                "value": "",
                "type": "query",
                "description": "Query parameter to indicate that the response should contain all the document bytes"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Download a document by its ID. You can choose to download the document directly or stream it."
        },
        {
          "info": {
            "name": "Import Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qargo.com/v1/orders/order/upload",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create or update orders in Qargo. See the \"Transport order creation & status\" section for more info."
        },
        {
          "info": {
            "name": "Get Order Import Status",
            "type": "http"
